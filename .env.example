# ZeptoMail (Zoho) — Mail Agent → Setup Info → "Send Mail token"
ZEPTOMAIL_TOKEN=
# Verified sender on your ZeptoMail domain
ZEPTOMAIL_FROM=no-reply@zaumu.com
ZEPTOMAIL_FROM_NAME=Zaumu
# Who receives demo requests (comma-separated)
SALES_TO=sales@zaumu.com
# Only if your ZeptoMail account is in the EU data centre
# ZEPTOMAIL_API_URL=https://api.zeptomail.eu/v1.1/email
# Links inside the emails (no trailing slash)
SITE_URL=https://zaumu.com
